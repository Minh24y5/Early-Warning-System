pected)\n    actual = np.asarray(actual)\n    # bin edges based on expected\n    quantiles = np.quantile(expected, np.linspace(0, 1, bins+1))\n    quantiles[0], quantiles[-1] = -np.inf, np.inf\n    \n    exp_counts, _ = np.histogram(expected, bins=quantiles)\n    act_counts, _ = np.histogram(actual, bins=quantiles)\n    \n    exp_perc = exp_counts / (len(expected) + 1e-12)\n    act_perc = act_counts / (len(actual) + 1e-12)\n    \n    # avoid division by zero\n    exp_perc = np.clip(exp_perc, 1e-6, None)\n    act_perc = np.clip(act_perc, 1e-6, None)\n    \n    return float(np.sum((act_perc - exp_perc) * np.log(act_perc / exp_perc)))\n\n# ---------- Score scaling ----------\ndef pd_to_score(pd, base_score=600, base_odds=50, pdo=20):\n    \"\"\"\n    Convert PD to credit score using log-odds scaling.\n    base_score at base_odds (good:bad). PDO = points to double odds.\n    \"\"\"\n    pd = np.clip(pd, 1e-6, 1-1e-6)\n    odds = (1 - pd) / pd\n    factor = pdo / np.log(2)\n    offset = base_score - factor * np.log(base_odds)\n    score = offset + factor * np.log(odds)\n    return score","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-11T02:48:08.529358Z","iopub.execute_input":"2026-08-11T02:48:08.530259Z","iopub.status.idle":"2026-08-11T02:48:08.574495Z","shell.execute_reply.started":"2026-08-11T02:48:08.530228Z","shell.execute_reply":"2026-08-11T02:48:08.573511Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"num_cols = [c for c in FEATURES if train_df[c].dtype.kind in 'ifb']\ncat_cols = [c for c in FEATURES if train_df[c].dtype.name in ('category', 'object')]","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-11T02:48:13.353801Z","iopub.execute_input":"2026-08-11T02:48:13.354514Z","iopub.status.idle":"2026-08-11T02:48:13.363689Z","shell.execute_reply.started":"2026-08-11T02:48:13.354485Z","shell.execute_reply":"2026-08-11T02:48:13.362707Z"}},"outputs":[],"execution_count":8},{"cell_type":"markdown","source":"#