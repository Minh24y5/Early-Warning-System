klearn.metrics import roc_auc_score, average_precision_score, brier_score_loss\n\n# ---------- KS ----------\ndef ks_stat(y_true, y_prob):\n    \"\"\"Compute KS statistic = max(TPR - FPR).\"\"\"\n    y_true = np.asarray(y_true)\n    y_prob = np.asarray(y_prob)\n    order = np.argsort(y_prob)\n    y_true_sorted = y_true[order]\n    y_prob_sorted = y_prob[order]\n    # cumulative distributions\n    cum_bad = np.cumsum(y_true_sorted) / (y_true_sorted.sum() + 1e-12)\n    cum_good = np.cumsum(1 - y_true_sorted) / ((1 - y_true_sorted).sum() + 1e-12)\n    ks = np.max(np.abs(cum_bad - cum_good))\n    return float(ks)\n\n# ---------- PSI (optional drift check) ----------\ndef psi(expected, actual, bins=10):\n    \"\"\"Population Stability Index between expected (train) and actual (oot).\"\"\"\n    expected = np.asarray(expected)\n    actual = np.asarray(actual)\n    # bin edges based on expected\n    quantiles = np.quantile(expected, np.linspace(0, 1, bins+1))\n    quantiles[0], quantiles[-1] = -np.inf, np.inf\n    \n    exp_counts, _ = np.histogram(expected, bins=quantiles)\n    act_counts, _ = np.histogram(actual, bins=quantiles)\n    \n    exp_perc = exp_counts / (len(expected) + 1e-12)\n    act_perc = act_counts / (len(actual) + 1e-12)\n    \n    # avoid division by zero\n    exp_perc = np.clip(exp_perc, 1e-6, None)\n    act_perc = np.clip(act_perc, 1e-6, None)\n    \n    return float(np.sum((act_perc - exp_perc) * np.log(act_perc / exp_perc)))\n\n# ---------- Score scaling ----------\ndef pd_to_score(pd, base_score=600, base_odds=50, pdo=20):\n    \"\"\"\n    Convert PD to credit score using log-odds scaling.\n    base_score at base_odds (good:bad). PDO = points to double odds.\n    \"\"\"\n    pd = np.clip(pd, 1e-6, 1-1e-6)\n    odds = (1 - pd) / pd\n    factor = pdo / np.log(2)\n    offset = base_score - factor * np.log(base_odds)\n    score = offset + factor * np.log(odds)\n    return score","metadata":{"_uuid":"e1789159-cc81-4f29-9ccc-fc9af75ad083","_cell_guid":"aa264934-23cb-4795-96d4-e28face0c0e9","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-08-17T07:17:40.743254Z","iopub.execute_input":"2026-08-17T07:17:40.743565Z","iopub.status.idle":"2026-08-17T07:17:40.789033Z","shell.execute_reply.started":"2026-08-17T07:17:40.74351Z","shell.execute_reply":"2026-08-17T07:17:40.788141Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":9},{"cell_type":"code","source":"num_cols = [c for c in FEATURES if train_df[c].dtype.kind in 'ifb']\ncat_cols = [c for c in FEATURES if train_df[c].dtype.name in ('category', 'object')]","metadata":{"_uuid":"bd323c57-6980-4a1a-8e27-0daa41987e18","_cell_guid":"f45b9941-9606-4426-9476-b694cf2c8aff","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-08-17T07:17:40.790256Z","iopub.execute_input":"2026-08-17T07:17:40.790735Z","iopub.status.idle":"2026-08-17T07:17:40.801763Z","shell.execute_reply.started":"2026-08-17T07:17:40.790711Z","shell.execute_reply":"2026-08-17T07:17:40.800967Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":10},{"cell_type":"markdown","source":"### Define Pipeline","metadata":{"_uuid":"301b12d0-9310-47ff-923f-76d3844e0ca7","_cell_guid":"00ea1910-5132-4de3-af53-942765d2ead4","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"import cupy as cp\nfrom sklearn.neural_network import MLPClassifier\nfrom sklearn.base import BaseEstimator, TransformerMixin\n\nnumeric_transformer = Pipeline(steps=[\n    (\"imputer\", SimpleImputer(strategy=\"median\")),\n    (\"scaler\", StandardScaler())\n])\ncategorical_transformer = Pipeline(steps=[\n    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", min_frequency=10))\n])\npreprocess = ColumnTransformer(\n    transformers=[\n        (\"num\", numeric_transformer, num_cols),\n        (\"cat\", categorical_transformer, cat_cols),\n    ],\n    remainder=\"drop