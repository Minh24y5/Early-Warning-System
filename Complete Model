oc[te])[:, 1]\n        aucs.append(roc_auc_score(y.iloc[te], p))\n    return float(np.mean(aucs))\n       \ndef evaluate_auc(model, X, y):\n \n    p = model.predict_proba(X)[:, 1]\n \n    if isinstance(p, cp.ndarray):\n        p = cp.asnumpy(p)\n \n    return float(\n        roc_auc_score(y, p)\n    )\n\ndef evaluate_gini(model, X, y):\n    auc = evaluate_auc (model, X, y)\n    return 2 * auc - 1","metadata":{"_uuid":"81aaed1e-ca56-44b8-a1bf-c9c4fb1352d9","_cell_guid":"2c2c5b44-b2a9-4eb8-8fae-f25b6cebe507","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-08-17T07:17:41.851497Z","iopub.execute_input":"2026-08-17T07:17:41.852023Z","iopub.status.idle":"2026-08-17T07:17:41.859174Z","shell.execute_reply.started":"2026-08-17T07:17:41.851988Z","shell.execute_reply":"2026-08-17T07:17:41.858126Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":12},{"cell_type":"markdown","source":"# ENSEMBLE","metadata":{"_uuid":"b339d131-a246-4010-ae36-c20ac9e370be","_cell_guid":"3a552f8b-e126-4cbf-abee-40339dd86f88","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"markdown","source":"## HGB + Logit + MLP","metadata":{"_uuid":"01661f8a-01ff-4a9f-85e6-a361d1529499","_cell_guid":"909c5fe9-1c99-42f7-a6de-22ee4214acd7","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"from scipy.stats import rankdata\nfrom scipy.optimize import minimize\nimport copy\n\ndef gini_from_preds(y_true, y_pred):\n    return 2 * roc_auc_score(y_true, y_pred) - 1\n\nN_FOLDS = 5\nkf = KFold(n_splits=N_FOLDS, shuffle=True, random_state=42)\noof_logit = np.zeros(len(train_df))\noof_mlp   = np.zeros(len(train_df))\noof_hgb   = np.zeros(len(train_df))\n\nfold_models_logit = []\nfold_models_mlp = []\nfold_models_hgb = []\n\nfor fold, (tr_idx, val_idx) in enumerate(kf.split(train_df)):\n    X_tr, X_val = train_df.iloc[tr_idx], train_df.iloc[val_idx]\n    y_tr, y_val = train_df['target'].iloc[tr_idx], train_df['target'].iloc[val_idx]\n\n    clf_logit.fit(X_tr[FEATURES], y_tr)\n    oof_logit[val_idx] = clf_logit.predict_proba(X_val[FEATURES])[:, 1]\n    fold_models_logit.append(copy.deepcopy(clf_logit))\n\n\n    clf_mlp.fit(X_tr[FEATURES], y_tr)\n    oof_mlp[val_idx] = clf_mlp.predict_proba(X_val[FEATURES])[:, 1]\n    fold_models_mlp.append(copy.deepcopy(clf_mlp))\n\n    clf_hgb.fit(X_tr[FEATURES], y_tr)\n    oof_hgb[val_idx] = clf_hgb.predict_proba(X_val[FEATURES])[:, 1]\n    fold_models_hgb.append(copy.deepcopy(clf_hgb))\n\n    print(f\"Fold {fold+1}: \"\n          f\"logit_gini={evaluate_gini(clf_logit, X_val, y_val):.4f} \"\n          f\"mlp_gini={evaluate_gini(clf_mlp, X_val, y_val):.4f} \"\n          f\"hgb_gini={evaluate_gini(clf_hgb, X_val, y_val):.4f}\")\n\n    del X_tr, X_val, y_tr, y_val\n    gc.collect()\n    \n\ny_true_all = train_df['target'].values\nprint(\"\\n=== Overall OOF Gini ===\")\nprint(f\"Logit: {gini_from_preds(y_true_all, oof_logit):.4f}\")\nprint(f\"MLP:   {gini_from_preds(y_true_all, oof_mlp):.4f}\")\nprint(f\"HGB:   {gini_from_preds(y_true_all, oof_hgb):.4f}\")","metadata":{"_uuid":"4f299069-bf0d-40dc-9774-305bb179bf01","_cell_guid":"17fee688-c97c-4789-babc-6d20a816db29","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"oof_matrix = np.vstack([oof_logit, oof_mlp, oof_hgb]).T\ny_true_ = train_df['target'].values\n\ndef neg_metric(weights):\n    weights = np.abs(weights)\n    weights /= weights.sum()\n    blend = oof_matrix @ weights\n    return -amex_metric_mod(y_true, blend)\n\ndef neg_gini(weights):\n    weights = np.abs(weights)\n    weights /= weights.sum()\n    blend = oof_matrix @ weights\n    return -gini_from_preds(y_true, blend)\n\nx0 = np.ones(oof_matrix.shape[1]) / oof_matrix.shape[1]\nres = minimize(neg_gini, x0, method='Nelder-Mead')\nbest_weights = np.abs(res.x) / np.abs(res.x).sum()\nprint(\"Best weights:\", best_weights, \"OOF score:\",